{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  /*
   * `stories/` and `.storybook/` are excluded from the app typecheck because
   * the Storybook packages are installed on demand (see README → Storybook),
   * not as app dependencies. Once `npx storybook@latest init` has been run,
   * remove these two entries so the stories typecheck with everything else.
   */
  "exclude": ["node_modules", "stories", ".storybook"]
}
